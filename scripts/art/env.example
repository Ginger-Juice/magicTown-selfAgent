# Copy these into the repo-root .env (gitignored). Do not commit keys.
# Image pipeline uses Google Gemini. Set ONLY GOOGLE_API_KEY.
# Do not also set GEMINI_API_KEY — the official SDK warns if both exist.
GOOGLE_API_KEY=
# Optional override. Default: gemini-3.1-flash-lite-image (fast / 1K)
GOOGLE_IMAGE_MODEL=
# After generate, punch cutouts in Cursor (local flood-fill), not another image model:
#   python scripts/art/punch.py b-townhall.png
# README brand frames (no punch — full scenes, not black-bg cutouts):
#   npm run art:readme
# writes assets/art-preview/readme-*.png and copies into assets/readme/
