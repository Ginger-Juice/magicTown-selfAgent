# Copy to .env and fill in. Town conversations default to DeepSeek.

TOWN_DEFAULT_MODEL=deepseek

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

MOONSHOTAI_API_KEY=
MOONSHOTAI_BASE_URL=https://api.moonshot.cn/v1
MOONSHOTAI_MODEL=kimi-k3

ZAI_API_KEY=
ZAI_MODEL=glm-5.2

# Gemini OpenAI-compat endpoint. Do not also set GEMINI_API_KEY.
GOOGLE_API_KEY=

OPENAI_API_KEY=

APP_ID=
APP_SECRET=
DATABASE_URL=
